<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-jdbc</artifactId>
	<version>1.1.0-SNAPSHOT</version>
	<name>Parley Files JDBC</name>
	<description>A parley-files FileSource implementation that keeps a file system in a database, via JDBC.
		Found at runtime through ServiceLoader. Formerly us.bringardner:bjl_file_system_jdbc.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.jdbcfile</parley.moduleName>
	</properties>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-jdbc</url>
		</repository>
	</distributionManagement>



	<dependencies>

		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-io</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
		<!-- The shared FileSource test suite -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.1.0-SNAPSHOT</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		
		<!-- The tests' database -->
		<dependency>
			<groupId>org.hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
			<version>2.7.3</version>
			<scope>test</scope>
		</dependency>
		<!-- A real PostgreSQL for the lock tests (locks kept by the database); skipped where it can't start -->
		<dependency>
			<groupId>io.zonky.test</groupId>
			<artifactId>embedded-postgres</artifactId>
			<version>2.0.7</version>
			<scope>test</scope>
		</dependency>
		<!-- JDBC drivers for JdbcMySqlLockTest, run against a server named by PARLEY_TEST_MYSQL_URL -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>8.4.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<version>3.4.1</version>
			<scope>test</scope>
		</dependency>




		<!-- Tests use JUnit 5; it used to arrive, wrongly, through bjl_file_system 0.1.1 (now parley-files) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>